{
  "openapi": "3.1.0",
  "info": {
    "title": "Team arbeidsforhold statistikk api",
    "description": "Team arbeidsforhold statistikk api",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "repo",
      "description": "Api for repoer"
    },
    {
      "name": "me",
      "description": "Api for info om innlogget bruker"
    },
    {
      "name": "admin",
      "description": "Api for administrasjon (manuell kjøring av cronjobber o.l.)"
    }
  ],
  "servers": [
    {
      "url": ""
    }
  ],
  "paths": {
    "/api/ingress": {
      "get": {
        "tags": [
          "ingress"
        ],
        "responses": {
          "200": {
            "description": "Lagrede ingresser gruppert etter antatt nettverkstilgang, med de mest åpne først",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngressOverview"
                }
              }
            }
          }
        }
      }
    },
    "/api/repo": {
      "get": {
        "tags": [
          "repo"
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Repo"
                  }
                }
              }
            },
            "description": "Liste over teamet's repoer"
          }
        }
      }
    },
    "/api/repo/{repoName}": {
      "get": {
        "tags": [
          "repo"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "repoName",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Navnet på repoet, slik som det er i url'er, dvs neste path-element etter /navikt/ på github"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RepoDetails"
                }
              }
            },
            "description": "Detaljer for ett repo"
          }
        }
      }
    },
    "/api/vulnerability/critical": {
      "get": {
        "tags": [
          "vulnerability"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "size",
            "schema": {
              "type": "integer"
            },
            "required": false,
            "description": "Antall"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CriticalVulnerability"
                  }
                }
              }
            },
            "description": "Kritiske sårbarheter"
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "me"
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            },
            "description": "Den innloggede brukeren"
          }
        }
      }
    },
    "/api/admin/nvdjobb": {
      "post": {
        "tags": [
          "admin"
        ],
        "responses": {
          "202": {
            "description": "Jobb startet"
          }
        }
      }
    },
    "/api/admin/naisjobb": {
      "post": {
        "tags": [
          "admin"
        ],
        "responses": {
          "202": {
            "description": "Jobb startet"
          }
        }
      }
    },
    "/api/admin/liquibase/unlock": {
      "post": {
        "tags": [
          "admin"
        ],
        "responses": {
          "200": {
            "description": "Lock removed"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "IngressOverview": {
        "type": "object",
        "properties": {
          "groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IngressGroup"
            }
          },
          "deploymentsWithoutManifest": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": ["groups", "deploymentsWithoutManifest"]
      },
      "IngressGroup": {
        "type": "object",
        "properties": {
          "exposure": {
            "type": "string",
            "enum": ["INTERNET", "UNKNOWN", "EMPLOYEES", "INTERNAL", "GCP"]
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "ingresses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ingress"
            }
          }
        },
        "required": ["exposure", "name", "description", "ingresses"]
      },
      "Ingress": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Ingress slik den står i manifestet. Kan være ugyldig og skal da fortsatt vises for manuell vurdering."
          },
          "repository": {
            "type": ["string", "null"],
            "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$",
            "description": "GitHub-repo fra deploymentets siste commit, på formen owner/repo. Null hvis ukjent."
          },
          "workload": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "suffix": {
            "type": "string",
            "description": "Lagret miljøsuffix, for eksempel q1. Tom streng hvis ikke brukt."
          },
          "lastSeen": {
            "type": ["string", "null"],
            "format": "date-time"
          }
        },
        "required": ["url", "workload", "environment", "suffix"]
      },
      "Repo": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "errorCount": {
            "type": "integer"
          },
          "criticalCount": {
            "type": "integer"
          }
        },
        "required": [
          "name",
          "url",
          "errorCount",
          "criticalCount"
        ]
      },
      "RepoDetails": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Repo"
          },
          {
            "type": "object",
            "properties": {
              "deploymentNames": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "environments": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "deploymentConsistent": {
                "type": "boolean"
              },
              "errors": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "deploymentNames",
              "environments",
              "deploymentConsistent"
            ]
          }
        ]
      },
      "Vulnerability": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      },
      "CriticalVulnerability": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Vulnerability"
          },
          {
            "type": "object",
            "properties": {
              "affectedRepositories": {
                "type": "integer",
                "description": "Repoer påvirket"
              }
            },
            "required": [
              "affectedRepositories"
            ]
          }
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "debug": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      }
    }
  }
}
